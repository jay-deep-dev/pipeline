# Environment Variables Configuration (LOCAL)
# This file contains actual environment values
# DO NOT commit this file to version control

# ============================================
# Kafka Configuration
# ============================================
KAFKA_BROKERS=localhost:29092,localhost:29093,localhost:29094
KAFKA_CLIENT_ID=ingestion-api

# Two-Stage Pipeline Topics
KAFKA_FILE_INGESTION_TOPIC=file-ingestion
KAFKA_VALIDATED_CHUNKS_TOPIC=validated-chunks

# DLQ Topics
KAFKA_FILE_INGESTION_DLQ_TOPIC=file-ingestion-dlq
KAFKA_VALIDATED_CHUNKS_DLQ_TOPIC=validated-chunks-dlq

# Consumer Groups
KAFKA_VALIDATION_CONSUMER_GROUP_ID=validation-service-workers
KAFKA_DB_INGESTION_CONSUMER_GROUP_ID=db-ingestion-service-workers

# Topic Partitions & Replication
KAFKA_FILE_INGESTION_PARTITIONS=10
KAFKA_FILE_INGESTION_REPLICATION_FACTOR=3
KAFKA_VALIDATED_CHUNKS_PARTITIONS=20
KAFKA_VALIDATED_CHUNKS_REPLICATION_FACTOR=3

# ============================================
# MongoDB Configuration
# ============================================
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=csv_ingestion
MONGODB_VALID_RECORDS_COLLECTION=csv_records
MONGODB_ERROR_RECORDS_COLLECTION=error_records
MONGODB_JOBS_COLLECTION=jobs

# ============================================
# Storage Configuration
# ============================================
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=5000

# ============================================
# API Configuration
# ============================================
API_PORT=3000

# ============================================
# Validation Service Configuration
# ============================================
VALIDATION_CHUNK_SIZE=10000
VALIDATION_MAX_CONCURRENT_FILES=6
VALIDATION_POLL_INTERVAL_MS=100

# ============================================
# DB Ingestion Service Configuration
# ============================================
DB_INGESTION_BATCH_SIZE=5000
DB_INGESTION_MAX_CONCURRENT_CHUNKS=24
DB_INGESTION_POLL_INTERVAL_MS=100
DB_INGESTION_RETRY_COUNT=3
DB_INGESTION_RETRY_BACKOFF_MS=1000

# ============================================
# Logging Configuration
# ============================================
LOG_LEVEL=info

# ============================================
# Zookeeper Configuration (for local)
# ============================================
ZOOKEEPER_CLIENT_PORT=2181
ZOOKEEPER_TICK_TIME=2000

# ============================================
# Kafka Broker Configuration (for local)
# ============================================
KAFKA_BROKER_ID=1
KAFKA_ZOOKEEPER_CONNECT=localhost:2181
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=3
KAFKA_AUTO_CREATE_TOPICS_ENABLE=false
KAFKA_LOG_RETENTION_HOURS=168
KAFKA_LOG_SEGMENT_BYTES=1073741824
KAFKA_LOG_RETENTION_CHECK_INTERVAL_MS=300000

# ============================================
# MongoDB Configuration (for local)
# ============================================
MONGO_INITDB_DATABASE=csv_ingestion
