# Environment Variables Configuration (LOCAL)
# This file contains actual environment values
# DO NOT commit this file to version control

# ====================================s========
# Kafka Configuration
# ============================================
KAFKA_BROKERS=localhost:29092
KAFKA_CLIENT_ID=ingestion-api
KAFKA_INGESTION_TOPIC=csv.ingestion
KAFKA_DLQ_TOPIC=csv.ingestion.dlq
KAFKA_CONSUMER_GROUP_ID=csv-ingestion-workers

# ============================================
# MongoDB Configuration
# ============================================
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=csv_ingestion
MONGODB_COLLECTION=csv_records

# ============================================
# Storage Configuration
# ============================================
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=5000

# ============================================
# API Configuration
# ============================================
API_PORT=3000

# ============================================
# Worker Configuration
# ============================================
BATCH_SIZE=10000
MAX_CONCURRENT_FILES=5
WORKER_POLL_INTERVAL_MS=100

# ============================================
# Logging Configuration
# ============================================
LOG_LEVEL=info

# ============================================
# Zookeeper Configuration (for local)
# ============================================
ZOOKEEPER_CLIENT_PORT=2181
ZOOKEEPER_TICK_TIME=2000

# ============================================
# Kafka Broker Configuration (for local)
# ============================================
KAFKA_BROKER_ID=1
KAFKA_ZOOKEEPER_CONNECT=localhost:2181
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1
KAFKA_AUTO_CREATE_TOPICS_ENABLE=true
KAFKA_LOG_RETENTION_HOURS=168
KAFKA_LOG_SEGMENT_BYTES=1073741824
KAFKA_LOG_RETENTION_CHECK_INTERVAL_MS=300000

# ============================================
# MongoDB Configuration (for local)
# ============================================
MONGO_INITDB_DATABASE=csv_ingestion
