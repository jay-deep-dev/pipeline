# Environment Variables Configuration (DOCKER)
# This file contains actual environment values
# DO NOT commit this file to version control

# ====================================s========
# Kafka Configuration
# ============================================
KAFKA_BROKERS=kafka-1:9092,kafka-2:9092,kafka-3:9092
KAFKA_CLIENT_ID=ingestion-api
KAFKA_INGESTION_TOPIC=csv.ingestion
KAFKA_DLQ_TOPIC=csv.ingestion.dlq
KAFKA_CONSUMER_GROUP_ID=csv-ingestion-workers

# ============================================
# MongoDB Configuration
# ============================================
MONGODB_URI=mongodb://mongodb:27017
MONGODB_DATABASE=csv_ingestion
MONGODB_COLLECTION=csv_records

# ============================================
# Storage Configuration
# ============================================
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE_MB=5000

# ============================================
# API Configuration
# ============================================
API_PORT=3000

# ============================================
# Worker Configuration
# ============================================
BATCH_SIZE=10000
MAX_CONCURRENT_FILES=5
WORKER_POLL_INTERVAL_MS=100

# ============================================
# Logging Configuration
# ============================================
LOG_LEVEL=info

# ============================================
# Zookeeper Configuration (for docker-compose)
# ============================================
ZOOKEEPER_CLIENT_PORT=2181
ZOOKEEPER_TICK_TIME=2000

# ============================================
# Kafka Broker Configuration (for docker-compose)
# ============================================
KAFKA_BROKER_ID=1
KAFKA_ZOOKEEPER_CONNECT=zookeeper:2181

KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=INTERNAL:PLAINTEXT,EXTERNAL:PLAINTEXT
KAFKA_INTER_BROKER_LISTENER_NAME=INTERNAL

KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=3
KAFKA_AUTO_CREATE_TOPICS_ENABLE=true
KAFKA_LOG_RETENTION_HOURS=168
KAFKA_LOG_SEGMENT_BYTES=1073741824
KAFKA_LOG_RETENTION_CHECK_INTERVAL_MS=300000

# ============================================
# MongoDB Configuration (for docker-compose)
# ============================================
MONGO_INITDB_DATABASE=csv_ingestion
